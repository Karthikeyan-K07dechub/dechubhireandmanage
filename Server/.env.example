PORT=4000
NODE_ENV=development
# Optional: use when a local DNS/VPN resolver blocks MongoDB Atlas lookups.
DNS_SERVERS=
PAYMENT_PROVIDER=dummy

CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/dechub

JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Stripe credentials: put real values in Server/.env or your hosting environment.
# Monthly hosted-invoice payments use these keys independently of PAYMENT_PROVIDER.
# Secret API key from Stripe Dashboard > API keys (test example: sk_test_REPLACE_ME).
STRIPE_SECRET_KEY=
# Signing secret from your Stripe webhook endpoint (example: whsec_REPLACE_ME).
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@example.com
# Optional HTTPS email provider. When set, Resend is used instead of SMTP.
RESEND_API_KEY=

DECHUB_ADMIN_EMAILS=admin@dechub.com
DECHUB_ADMIN_PASSWORD=Admin@1234

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Optional: Bridge Visitor (ElevenLabs) server-to-server tool authentication.
# Set both values in local .env and the Render service environment before enabling the agent.
AI_TOOL_SECRET=
# When true, AI talent matching returns only active contractors with approved KYC.
AI_TALENT_REQUIRE_VERIFIED=false
ELEVENLABS_WEBHOOK_SECRET=

# Local Stripe forwarding: stripe listen --forward-to localhost:4000/api/stripe/webhook
# Use the CLI listener signing secret as STRIPE_WEBHOOK_SECRET for local tests.
# See STRIPE_SETUP.md for monthly invoice linking and production webhook setup.

# Private Supabase storage (backend only). Use a server secret, never a VITE_ variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_CONTRACTOR_KYC_BUCKET=KYC-Contractor-docs
SUPABASE_CLIENT_KYB_BUCKET=KYC-client-docs
SUPABASE_INVOICE_BUCKET=client-invoices
